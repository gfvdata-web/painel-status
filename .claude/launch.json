{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "painel-status",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8731",
        "--directory",
        "docs"
      ],
      "port": 8731
    },
    {
      "name": "painel-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "wrangler",
        "dev",
        "--config",
        "worker/wrangler.jsonc",
        "--port",
        "8787",
        "--test-scheduled"
      ],
      "port": 8787
    }
  ]
}
