// Worker único do painel: serve a página (docs/, como arquivos estáticos), os dados
// (/dados/*, no D1) e o APK do app (/app/*, no KV). Como funciona: seção "Cloudflare"
// do README.md. Só serviços do plano grátis que param no limite em vez de cobrar
// (sem R2, que cobra o excedente).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painel-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "painel.gfvdata.com", "custom_domain": true }],
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    // /dados/* sai do D1 (com o arquivo estático como reserva); /app/* é o APK (KV) e
    // o versao.json (D1) do app Android; /api/* recebe os envios.
    "run_worker_first": ["/dados/*", "/app/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "BANCO",
      "database_name": "painel-status",
      "database_id": "037d686d-1ecb-4ba6-a623-44aff9d6753e",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "APKS", "id": "3ed1317237a0402399b22cf450e976e7" }],
  // Agenda da coleta (ver agendar() em src/index.ts). Usa 1 dos 5 Cron Triggers da conta.
  "triggers": { "crons": ["*/30 * * * *"] }
  // Segredos (wrangler secret put):
  //   TOKEN_ENVIO           o mesmo do secret PAINEL_TOKEN_ENVIO no GitHub
  //   GITHUB_TOKEN_DISPARO  token fine-grained, só gfvdata-web/painel-status, Actions: write
}
