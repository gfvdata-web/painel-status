// Worker único do painel: serve a página (docs/, como arquivos estáticos) e os dados
// (/dados/*) guardados no R2. Como funciona: seção "Cloudflare" do README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painel-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "painel.gfvdata.com", "custom_domain": true }],
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    // /dados/* sai do R2 (com o arquivo estático como reserva); /app/* é o APK e o
    // versao.json do app Android (R2); /api/* recebe os envios.
    "run_worker_first": ["/dados/*", "/app/*", "/api/*"]
  },
  "r2_buckets": [{ "binding": "DADOS", "bucket_name": "painel-status-dados" }],
  // Agenda da coleta (ver agendar() em src/index.ts). Usa 1 dos 5 Cron Triggers da conta.
  "triggers": { "crons": ["*/30 * * * *"] }
  // Segredos (wrangler secret put):
  //   TOKEN_ENVIO           o mesmo do secret PAINEL_TOKEN_ENVIO no GitHub
  //   GITHUB_TOKEN_DISPARO  token fine-grained, só gfvdata-web/painel-status, Actions: write
}
