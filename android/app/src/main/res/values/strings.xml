    <!-- Sobre -->
    <string name="sobre_texto">Acompanha os sites publicados pela conta gfvdata-web: se estão no ar, quando os dados mudaram, as rotinas de coleta e o passo a passo de cada atualização do Bolão F1. Tudo vem do painel publicado em painel.gfvdata.com; o app só lê. Com o app fechado, ele pode avisar por notificação (ícone do sino).</string>
    <string name="sobre_recarga">Com o app aberto, o painel é conferido a cada %1$d min (o mesmo intervalo da página). Puxe a tela para baixo para conferir na hora.</string>
    <string name="abrir_painel_web">Abrir o painel na web</string>
    <string name="sobre_limites">Avisos dos limites do Claude: o coletor roda no PC a cada 30 min, então o aviso só chega com o PC ligado e pode atrasar uns 45 min.</string>
    <string name="sobre_versao">Versão %1$s · build %2$d</string>

    <!-- Avisos com o app fechado -->
    <string name="avisos_titulo">Avisos</string>
    <string name="avisos_explicacao">Com o app fechado, o Android confere o painel a cada %1$d min mais ou menos. Enquanto o fluxo do Bolão F1 anda, a cada %2$d min, até a página ser atualizada.</string>
    <string name="avisos_ativar">Avisar com o app fechado</string>
    <string name="avisos_bolao">Bolão F1 — passo a passo</string>
    <string name="avisos_bolao_descricao">Palpites recebidos, aguardando o resultado do quali, página atualizada ou falha no pipeline.</string>
    <string name="avisos_sites">Alertas dos sites</string>
    <string name="avisos_sites_descricao">Site fora do ar, coleta que falhou, foi cancelada ou parou.</string>
    <string name="avisos_limites">Limites do Claude</string>
    <string name="avisos_limites_descricao">Janela de 5 horas ou de 7 dias passou de 80 por cento do limite ou zerou. Precisa estar logado na aba IA; o coletor roda no PC, então o aviso só chega com ele ligado e pode atrasar uns 45 min.</string>
    <string name="avisos_bloqueados">As notificações deste app estão bloqueadas no Android. Libere para receber os avisos.</string>
    <string name="avisos_abrir_configuracoes">Abrir configurações de notificação</string>
    <string name="avisos_sem_verificacao">Ainda não houve verificação em segundo plano.</string>
    <string name="avisos_ultima_verificacao">Última verificação em segundo plano: %1$s</string>
    <string name="avisos_testar">Enviar uma notificação de teste</string>
    <string name="avisos_bateria">Com a economia de bateria ligada, o Android pode atrasar as verificações. Se os avisos demorarem, tire o app da otimização de bateria nas configurações do celular.</string>
    <string name="faixa_avisos_titulo">Avisar com o app fechado?</string>
    <string name="faixa_avisos_texto">O app pode notificar quando o Bolão F1 andar (palpites recebidos, página atualizada, falha) e quando um site tiver alerta.</string>
    <string name="faixa_avisos_ativar">Ativar</string>

